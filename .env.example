# ASI:One credentials.
ASI_ONE_API_KEY=
ASI_ONE_MODEL=asi1


# OpenRouter speech. Get a key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_TTS_MODEL=fish-audio/s2.1-pro-free:free

PORT=3000

# MongoDB Atlas connection string (grant this application a least-privilege DB user).
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/<database>?retryWrites=true&w=majority

# Create a Google OAuth 2.0 Web application and add this exact redirect URI:
# http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Back up this key securely. Losing it makes encrypted profiles and chats unreadable.
DATA_ENCRYPTION_KEY=

# Set to production only when served over HTTPS.
NODE_ENV=development
